FROM %%BASE%% AS build

ENV TCL_VERSION=%%TCL_VERSION%%
ENV TCL_SHA256=%%TCL_SHA256%%

# The toolchain stays in this stage: it is also the base of the "dev" target.
# The Rocky base images are rebuilt rarely (8-minimal last in 2024), so OS updates are applied
# here; UPDATE_MONTH (CI passes the current month) reruns this step monthly instead of caching it.
ARG UPDATE_MONTH
RUN set -eux; \
	microdnf -y update; \
# findutils: Tcl 9's build runs find to pack its script library; Rocky 8 minimal lacks it
	microdnf -y install gcc make tar gzip zlib-devel findutils; \
	microdnf clean all

RUN set -eux; \
	curl -fsSL --retry 5 --retry-delay 5 -o tcl.tar.gz "https://downloads.sourceforge.net/project/tcl/Tcl/${TCL_VERSION}/tcl${TCL_VERSION}-src.tar.gz"; \
	echo "${TCL_SHA256} *tcl.tar.gz" | sha256sum -c -; \
	mkdir -p /usr/src/tcl; \
	tar -xzf tcl.tar.gz -C /usr/src/tcl --strip-components=1; \
	rm tcl.tar.gz; \
	cd /usr/src/tcl/unix; \
# 8.5's configure probes use K&R prototypes that C23 would misread; pin the older standard
# its stack-direction probe is optimised away by newer gcc and answers "up"; every
# supported CPU (x86-64, arm64) grows the stack down
# 8.5 is built non-threaded, upstream's default for 8.5; 8.6 and 9 threaded, theirs
	threads=--enable-threads; \
	case "$TCL_VERSION" in 8.5.*) export CFLAGS='-O2 -std=gnu17' tcl_cv_stack_grows_up=no; threads=--disable-threads ;; esac; \
	./configure --prefix=/usr/local "$threads" --enable-shared; \
# Tcl 9's bundled packages run the in-tree tclsh, whose rpath points at the not yet installed libtcl
	LD_LIBRARY_PATH="$PWD" make -j"$(nproc)"; \
	LD_LIBRARY_PATH="$PWD" make install; \
	ln -s "tclsh${TCL_VERSION%.*}" /usr/local/bin/tclsh; \
	install -D -m 644 /usr/src/tcl/license.terms /usr/local/share/licenses/tcl/license.terms; \
	cd /; \
	rm -rf /usr/src/tcl; \
# RHEL-family systems do not search /usr/local/lib by default
	echo /usr/local/lib > /etc/ld.so.conf.d/usr-local.conf; \
	ldconfig; \
# run from /dev/stdin, not a pipe, so a Tcl error or a wrong version fails the build
	echo "if {[info patchlevel] ne {$TCL_VERSION}} { error \"got [info patchlevel]\" }" | tclsh /dev/stdin


# "-dev" tags: Tcl plus make, gcc, glibc and zlib headers and curl, for building extensions
# that then run on the runtime image
FROM build AS dev

# many Tcl scripts hardcode #!/usr/bin/tclsh, where Debian and RHEL put their own tclsh
RUN ln -s /usr/local/bin/tclsh /usr/bin/tclsh

CMD ["tclsh"]


# runtime: only Tcl on top of the base image; stays the last stage, so it is the default.
# (microdnf cannot cleanly remove the toolchain, so a fresh image is the only lean option anyway)
FROM %%BASE%%

ENV TCL_VERSION=%%TCL_VERSION%%
ENV TCL_SHA256=%%TCL_SHA256%%

# OS updates for the published image too (see the build stage)
ARG UPDATE_MONTH
RUN microdnf -y update && microdnf clean all

COPY --from=build /usr/local /usr/local

RUN set -eux; \
# RHEL-family systems do not search /usr/local/lib by default
	echo /usr/local/lib > /etc/ld.so.conf.d/usr-local.conf; \
	ldconfig; \
# Tcl only links glibc and zlib, which the base image has; fail loudly if that ever changes
	for f in /usr/local/bin/tclsh?* /usr/local/lib/*.so* /usr/local/lib/*/*.so; do \
		[ -e "$f" ] || continue; \
		if ldd "$f" 2>&1 | grep 'not found'; then echo "missing library for $f" >&2; exit 1; fi; \
	done; \
# many Tcl scripts hardcode #!/usr/bin/tclsh, where Debian and RHEL put their own tclsh
	ln -s /usr/local/bin/tclsh /usr/bin/tclsh; \
	echo "if {[info patchlevel] ne {$TCL_VERSION}} { error \"got [info patchlevel]\" }" | tclsh /dev/stdin

CMD ["tclsh"]

# DO NOT EDIT: generated by apply-templates.sh from Dockerfile-alpine.template

FROM alpine:3.24

ENV TCL_VERSION=8.6.18
ENV TCL_SHA256=14f9af32b1767ff718477a8f974ad03c34341097e6b43f4ce54644ee974e268e

# Build from source, then drop the toolchain and keep only the shared libraries the
# installed binaries need (same approach as the official python alpine image).
RUN set -eux; \
	apk add --no-cache --virtual .build-deps curl gcc make musl-dev zlib-dev scanelf \
# Tcl 9's epoll notifier includes sys/queue.h, which musl does not ship
		bsd-compat-headers; \
	curl -fsSL --retry 5 --retry-delay 5 -o tcl.tar.gz "https://downloads.sourceforge.net/project/tcl/Tcl/${TCL_VERSION}/tcl${TCL_VERSION}-src.tar.gz"; \
	echo "${TCL_SHA256} *tcl.tar.gz" | sha256sum -c -; \
	mkdir -p /usr/src/tcl; \
	tar -xzf tcl.tar.gz -C /usr/src/tcl --strip-components=1; \
	rm tcl.tar.gz; \
	cd /usr/src/tcl/unix; \
# 8.5's configure probes use implicit declarations and K&R prototypes like "extern double strtod();",
# which gcc 15's default C23 reads as taking no arguments; configure then adds both strtod
# replacements and the link fails
	case "$TCL_VERSION" in 8.5.*) export CFLAGS='-O2 -std=gnu17 -fpermissive' ;; esac; \
	./configure --prefix=/usr/local --enable-threads --enable-shared; \
# Tcl 9's bundled packages run the in-tree tclsh, whose rpath points at the not yet installed libtcl
	LD_LIBRARY_PATH="$PWD" make -j"$(nproc)"; \
	LD_LIBRARY_PATH="$PWD" make install; \
	ln -s "tclsh${TCL_VERSION%.*}" /usr/local/bin/tclsh; \
	install -D -m 644 /usr/src/tcl/license.terms /usr/local/share/licenses/tcl/license.terms; \
	cd /; \
	rm -rf /usr/src/tcl; \
	\
	runDeps="$(scanelf --needed --nobanner --format '%n#p' --recursive /usr/local \
		| tr ',' '\n' | sort -u \
		| awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }')"; \
	apk add --no-cache --virtual .tcl-rundeps $runDeps; \
	apk del --no-network .build-deps; \
	\
# run from /dev/stdin, not a pipe, so a Tcl error or a wrong version fails the build
	echo "if {[info patchlevel] ne {$TCL_VERSION}} { error \"got [info patchlevel]\" }" | tclsh /dev/stdin

CMD ["tclsh"]
